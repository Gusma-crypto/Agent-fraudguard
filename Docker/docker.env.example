# Copy to ../.env.production and replace every placeholder.
APP_ENV=production
FRAUDGUARD_CORE_BASE_URL=http://fraudguard-core-api:8000/api/v1
FRAUDGUARD_CORE_API_KEY=replace-with-scoped-core-key
AGENT_ACCESS_KEY=replace-with-agent-client-key
AGENT_MODEL_PROVIDER=deterministic
AGENT_MAX_TOOL_STEPS=8
AGENT_MAX_TURNS=20
AGENT_CORE_TIMEOUT_SECONDS=10
AGENT_REPLICAS=1
AGENT_CORS_ORIGINS=https://agent.example.com
AGENT_PORT=3000
AGENT_RUNTIME=openclaw
OPENCLAW_BRIDGE_PORT=3100
# Gateway must bind to the private Docker host-gateway address; never publish 18789 publicly.
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
OPENCLAW_AGENT_ID=fraudguard
OPENCLAW_TIMEOUT_SECONDS=60
